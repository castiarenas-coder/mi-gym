{
  "name": "mi-gym",
  "version": "0.2.1",
  "private": true,
  "description": "Rumbo Fit: ejercicios, rutinas y progreso, todo en español y guardado en tu PC.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "lan": "node server/index.js --lan",
    "dev": "concurrently -k -n servidor,web -c yellow,blue \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "test": "node --test test/*.test.js",
    "test:client": "npm --prefix client test",
    "build": "npm --prefix client run build",
    "postinstall": "npm --prefix client install",
    "backup": "node server/backup.js",
    "restore": "node server/backup.js restore",
    "importar": "node scripts/importar-catalogo.js",
    "acceso-directo": "node scripts/crear-acceso-directo.js",
    "preparar-catalogo": "node scripts/preparar-catalogo.js",
    "instalador": "node scripts/instalador.js",
    "apk": "npm run build && node scripts/android-stage.js && node scripts/android-build.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "sharp": "^0.35.5"
  }
}

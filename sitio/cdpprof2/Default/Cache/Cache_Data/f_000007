en; min-height: var(--toque); }\n.resultado-barra__cuenta { margin: 0; color: var(--texto-suave); font-weight: 700; }\n\n/* ---- Tarjetas ---- */\n.grilla-ej { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }\n@media (min-width: 640px) { .grilla-ej { grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; } }\n.tarjeta-ej { position: relative; background: var(--superficie); border: 1px solid var(--borde); border-radius: var(--radio-m); overflow: hidden; transition: border-color 0.15s ease, transform 0.15s ease; }\n.tarjeta-ej:hover { border-color: color-mix(in srgb, var(--acento) 60%, var(--borde)); transform: translateY(-2px); }\n.tarjeta-ej__enlace { display: block; }\n.tarjeta-ej__texto { padding: 12px 12px 14px; display: grid; gap: 8px; }\n.tarjeta-ej__nombre { margin: 0; font-family: var(--fuente-texto); font-weight: 800; font-size: 0.98rem; line-height: 1.25; letter-spacing: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; }\n.tarjeta-ej__foto { position: relative; }\n.tarjeta-ej__fav { position: absolute; top: 8px; right: 8px; z-index: 2; }\n\n.favorito { display: inline-grid; place-items: center; width: var(--toque); height: var(--toque); border-radius: 50%; border: 0; background: color-mix(in srgb, var(--superficie) 88%, transparent); border: 1px solid var(--borde); color: var(--texto); transition: transform 0.12s ease, color 0.12s ease; }\n.favorito:hover:not(:disabled) { transform: scale(1.1); }\n.favorito--activo { color: var(--acento-2); }\n.favorito--grande { position: static; width: 52px; height: 52px; flex: none; background: var(--superficie-2); border: 1px solid var(--borde); }\n\n.tira { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 8px; scroll-snap-type: x proximity; }\n@media (pointer: fine) { .tira { scrollbar-width: thin; scrollbar-color: var(--borde) transparent; } }\n.tira > * { flex: none; width: 200px; scroll-snap-align: start; }\n\n/* ---- Animación ---- */\n.anim { position: relative; width: 100%; aspect-ratio: 4 / 3; background: var(--superficie-2); overflow: hidden; }\n.anim__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; }\n.anim__img--activa { opacity: 1; }\n.anim__video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: contain; background: #000; }\n.anim__vacio { position: absolute; inset: 0; display: grid; place-items: center; background: linear-gradient(135deg, var(--superficie-2), color-mix(in srgb, var(--superficie-2) 60%, var(--superficie))); color: var(--texto-suave); }\n.anim__control { position: absolute; right: 8px; bottom: 8px; display: grid; place-items: center; width: var(--toque); height: var(--toque); border-radius: 50%; border: 0; z-index: 1; background: color-mix(in srgb, var(--superficie) 90%, transparent); border: 1px solid var(--borde); color: var(--texto); }\n.anim--grande { border-radius: var(--radio-l); border: 1px solid var(--borde); }\n\n/* ---- Ficha ---- */\n.ficha__cabecera { display: grid; gap: 20px; }\n@media (min-width: 800px) { .ficha__cabecera { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: start; } }\n.ficha__info { display: grid; gap: 18px; }\n.marcas { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }\n.ficha__ingles { margin: 0; color: var(--texto-suave); font-size: 0.85rem; }\n.datos { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0; }\n.dato { background: var(--superficie); border: 1px solid var(--borde); border-radius: var(--radio-s); padding: 10px 12px; }\n.dato dt { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--texto-suave); }\n.dato dd { margin: 2px 0 0; font-weight: 800; }\n\n.bloque { display: grid; gap: 12px; align-content: start; }\n.bloque__titulo { font-size: 0.95rem; margin: 0 0 8px; text-transform
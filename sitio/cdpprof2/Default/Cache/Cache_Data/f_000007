const __vite__css = "/* Tokens de diseño. Todo color y medida sale de acá.\n   El tema se elige con data-tema en <html>; sin atributo se ve el oscuro. */\n:root, [data-tema='oscuro'] {\n  color-scheme: dark;\n  --fondo: #0a0c10;\n  --superficie: #14171d;\n  --superficie-2: #1c2028;\n  --borde: #2a2f39;\n  --texto: #f2f4f7;\n  --texto-suave: #9aa3b0;\n  --acento: #c6ff3d;\n  --acento-texto: #0a0c10;\n  --record: #ff8a2b;\n  --ok: #3ddc84;\n  --aviso: #ffc233;\n  --peligro: #ff5c5c;\n  --sombra: none;\n}\n\n[data-tema='claro'] {\n  color-scheme: light;\n  --fondo: #f5f5f1;\n  --superficie: #ffffff;\n  --superficie-2: #eeeee9;\n  --borde: #d8d9d4;\n  --texto: #14171c;\n  --texto-suave: #586170;\n  --acento: #4d7c0f;\n  --acento-texto: #ffffff;\n  --record: #c2410c;\n  --ok: #15803d;\n  --aviso: #92400e;\n  --peligro: #c62828;\n  --sombra: 0 1px 2px rgb(20 23 28 / 8%), 0 4px 12px rgb(20 23 28 / 6%);\n}\n\n:root {\n  --acento-2: var(--record); /* alias: el naranja ahora se llama --record */\n\n  --sobre-color: #0a0c10; /* texto sobre los colores fijos de las personas, igual en ambos temas */\n  --radio-s: 10px;\n  --radio-m: 16px;\n  --radio-l: 24px;\n  --espacio: 16px;\n  --toque: 48px; /* tamaño mínimo de un botón táctil */\n  --alto-nav: 68px;\n  --alto-header: 56px;\n  --ancho-max: 1100px;\n\n  --fuente-titulo: 'Archivo Variable', 'Archivo', 'Arial Narrow', system-ui, sans-serif;\n  --fuente-texto: 'Manrope Variable', 'Manrope', system-ui, sans-serif;\n\n  /* Escala tipográfica */\n  --t-display: 2.75rem;\n  --t-titulo: 1.75rem;\n  --t-subtitulo: 1.2rem;\n  --t-chico: 0.8rem;\n}\n\n/* Piezas comunes + ejercicios (lista, tarjetas, ficha, animación). */\n\n.pagina { display: grid; gap: var(--espacio); align-content: start; }\n.centrado { display: flex; justify-content: center; padding: 8px 0; }\n.oculto { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; pointer-events: none; }\n\n/* ---- Controles ---- */\n.control {\n  width: 100%; min-height: var(--toque); padding: 0 14px;\n  background: var(--superficie-2); color: var(--texto);\n  border: 1px solid var(--borde); border-radius: var(--radio-s);\n  font: inherit; font-size: 1rem;\n}\n.control:focus { outline: 2px solid var(--acento); outline-offset: 1px; border-color: var(--acento); }\nselect.control { appearance: none; padding-right: 36px; background-image: linear-gradient(45deg, transparent 50%, var(--texto-suave) 50%), linear-gradient(135deg, var(--texto-suave) 50%, transparent 50%); background-position: calc(100% - 20px) 50%, calc(100% - 15px) 50%; background-size: 5px 5px; background-repeat: no-repeat; }\n.campo { display: grid; gap: 4px; min-width: 0; }\n.campo--crece { flex: 1; }\n.campo__etiqueta { font-size: 0.78rem; font-weight: 700; color: var(--texto-suave); text-transform: uppercase; letter-spacing: 0.04em; }\n\n.boton {\n  display: inline-flex; align-items: center; justify-content: center; gap: 8px;\n  min-height: var(--toque); padding: 0 20px; border-radius: 999px;\n  border: 1px solid transparent; font-family: var(--fuente-titulo); font-stretch: 75%; text-transform: uppercase; letter-spacing: 0.03em; font-weight: 800; font-size: 1.05rem;\n  background: var(--superficie-2); color: var(--texto); cursor: pointer; text-align: center;\n  transition: transform 0.08s ease, background 0.15s ease, border-color 0.15s ease;\n}\n.boton:active { transform: scale(0.97); }\n.boton:disabled { opacity: 0.5; cursor: not-allowed; }\n.boton--principal { background: var(--acento); color: var(--acento-texto); }\n.boton--principal:hover:not(:disabled) { background: color-mix(in srgb, var(--acento) 88%, var(--texto)); }\n.boton--secundario { border-color: var(--borde); }\n.boton--secundario:hover:not(:disabled) { border-color: var(--acento); }\n.boton--peligro { background: transparent; border-color: color-mix(in srgb, var(--peligro) 55%, transparent); color: var(--peligro); }\n.boton--texto { background: none; min-height: var(--toque); padding: 0 8px; color: va
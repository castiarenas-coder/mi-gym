er-color: var(--record); animation: pulso 0.8s ease-in-out 3; }\r\n@keyframes pulso { 50% { background: color-mix(in srgb, var(--record) 22%, var(--superficie-2)); } }\r\n.descanso__barra { height: 5px; background: var(--borde); }\r\n.descanso__barra span { display: block; height: 100%; background: var(--acento); transition: width 0.25s linear; }\r\n.descanso--fin .descanso__barra span { background: var(--record); }\r\n.descanso__cuerpo { display: flex; align-items: center; gap: 10px; padding: 10px 12px; }\r\n.descanso__tiempo { flex: 1; min-width: 0; display: grid; }\r\n.descanso__etiqueta { color: var(--texto-suave); font-size: var(--t-chico); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; }\r\n.descanso__tiempo strong { font-size: var(--t-titulo); line-height: 1.1; }\r\n.descanso__saltar { padding: 0 14px; }\r\n@media (min-width: 900px) { .descanso { left: calc(var(--ancho-lateral) + 8px); bottom: 16px; } }\r\n\r\n/* ---- Historial ---- */\r\n.historial { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }\r\n.historial__item { display: flex; align-items: center; gap: 14px; padding: 14px; background: var(--superficie); border: 1px solid var(--borde); border-radius: var(--radio-m); }\r\n.historial__item:hover { border-color: var(--acento); }\r\n.historial__fecha { flex: none; width: 74px; color: var(--acento); font-weight: 800; font-size: 0.9rem; text-transform: capitalize; }\r\n.historial__texto { flex: 1; min-width: 0; display: grid; gap: 2px; }\r\n.historial__texto strong { overflow-wrap: anywhere; }\r\n.historial__texto span { color: var(--texto-suave); font-size: 0.85rem; }\r\n.historial__nombres { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n.historial__item > svg { color: var(--texto-suave); flex: none; }\r\n.ej-historial { display: grid; gap: 10px; }\r\n.ej-historial h2 { margin: 0; font-family: var(--fuente-texto); font-size: 1.05rem; font-weight: 800; }\r\n.ej-historial h2 a:hover { color: var(--acento); }\r\n.series-historial { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }\r\n.series-historial li { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--superficie-2); border-radius: 999px; font-weight: 700; }\r\n.series-historial__n { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--acento); color: var(--acento-texto); font-size: 0.75rem; font-weight: 800; }\r\n\r\n/* ---- Inicio ---- */\r\n.inicio { gap: 16px; }\r\n.inicio__saludo { display: grid; gap: 2px; min-width: 0; }\r\n.inicio__titulo { margin: 0; font-size: clamp(1.5rem, 5vw, 2rem); overflow-wrap: anywhere; }\r\n.inicio__fecha { margin: 0; color: var(--texto-suave); }\r\n.inicio__hoy, .inicio__ultimo { display: grid; gap: 12px; }\r\n.inicio__sup { margin: 0; color: var(--texto-suave); font-family: var(--fuente-texto); font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.78rem; }\r\n.inicio__sesion { margin: 0; font-family: var(--fuente-titulo); font-size: 1.2rem; font-weight: 700; overflow-wrap: anywhere; }\r\n.inicio__sesion .inicio__fecha { font-family: var(--fuente-texto); font-size: 0.92rem; font-weight: 400; text-transform: none; }\r\n.inicio__rutinas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }\r\n.inicio__rutina { min-width: 0; max-width: 100%; }\r\n.inicio__rutina span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n.inicio__metricas { display: flex; flex-wrap: wrap; gap: 8px 32px; }\r\n\r\n/* ---- Progreso ---- */\r\n.tabs { padding-bottom: 4px; }\r\n.formulario-medidas { display: grid; gap: 14px; }\r\n.formulario-medidas .seccion__titulo { margin: 0; }\r\n.grilla-campos { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }\r\n.tabla-scroll { overflow-x: auto; margin: 0 -4px; }\r\n.tabla { width: 100%; border-collapse: collapse; font-size: 
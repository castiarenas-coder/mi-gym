e { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--texto); }\n.tarjeta-rutina__enlace svg { color: var(--acento); flex: none; }\n.tarjeta-rutina__nombre { margin: 0 0 4px; font-family: var(--fuente-titulo); font-stretch: 75%; font-size: var(--t-subtitulo); overflow-wrap: anywhere; }\n.tarjeta-rutina__meta { margin: 0; color: var(--texto-suave); font-weight: 700; font-size: var(--t-chico); }\n.tarjeta-rutina__desc { margin: 6px 0 0; color: var(--texto-suave); font-size: 0.9rem; }\n.tarjeta-rutina__dias { list-style: none; margin: 0; padding: 0; }\n.tarjeta-rutina__acciones { display: flex; gap: 8px; flex-wrap: wrap; }\n.tarjeta-rutina__acciones .boton { flex: 1; min-width: 120px; }\n\n/* ---- Edición ---- */\n.rutina-cabecera { display: grid; gap: 10px; }\n.titulo-editable { width: 100%; min-height: var(--toque); background: none; border: 0; border-bottom: 2px solid var(--borde); padding: 6px 0; color: var(--texto); font-family: var(--fuente-titulo); font-stretch: 75%; font-weight: 800; font-size: var(--t-titulo); }\n.titulo-editable:focus { outline: none; border-bottom-color: var(--acento); }\n.control--area { padding: 10px 14px; min-height: 64px; resize: vertical; line-height: 1.4; }\n\n.dia { display: grid; gap: 12px; padding: 16px; background: var(--superficie); border: 1px solid var(--borde); border-radius: var(--radio-l); }\n.dia__cabecera { display: flex; gap: 8px; align-items: center; }\n.dia__nombre { flex: 1; font-weight: 800; font-family: var(--fuente-titulo); font-stretch: 75%; font-size: var(--t-subtitulo); min-width: 0; }\n.lista-ej { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }\n.fila-ej { display: grid; gap: 10px; padding: 12px; background: var(--superficie-2); border: 1px solid var(--borde); border-radius: var(--radio-m); }\n.fila-ej__cabecera { display: flex; align-items: center; gap: 12px; }\n.fila-ej__titulo { flex: 1; min-width: 0; display: grid; }\n.fila-ej__nombre { font-weight: 800; line-height: 1.25; overflow-wrap: anywhere; }\n.fila-ej__nombre:hover { color: var(--acento); }\n.fila-ej__meta { color: var(--texto-suave); font-size: 0.8rem; }\n.fila-ej__botones { display: flex; gap: 6px; flex: none; }\n.fila-ej__botones .icono-boton { width: var(--toque); height: var(--toque); background: var(--superficie); }\n.fila-ej__campos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }\n.campo--nota { grid-column: 1 / -1; }\n@media (min-width: 700px) { .fila-ej__campos { grid-template-columns: 90px 110px 130px minmax(0, 1fr); } .campo--nota { grid-column: auto; } }\n.fila-ej .control { background: var(--superficie); text-align: center; padding: 0 8px; }\n.campo--nota .control { text-align: left; padding: 0 12px; }\n\n.miniatura { width: 72px; flex: none; border-radius: var(--radio-s); aspect-ratio: 1; }\n.miniatura .anim__vacio svg { width: 26px; height: 26px; }\n\n/* ---- Buscador de ejercicios ---- */\n.lista-busqueda { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }\n.fila-busqueda { display: flex; align-items: center; gap: 12px; padding: 8px; background: var(--superficie-2); border: 1px solid var(--borde); border-radius: var(--radio-m); }\n.fila-busqueda__texto { flex: 1; min-width: 0; display: grid; }\n.fila-busqueda__texto strong { line-height: 1.25; overflow-wrap: anywhere; }\n.fila-busqueda__texto span { color: var(--texto-suave); font-size: 0.8rem; }\n.icono-boton--acento { background: var(--acento); color: var(--acento-texto); border-color: var(--acento); flex: none; }\n\n/* Ajustes */\n.datos { display: grid; grid-template-columns: max-content 1fr; gap: 6px 14px; margin: 0; font-size: 0.92rem; }\n.datos dt { color: var(--texto-suave); font-weight: 700; }\n.datos dd { margin: 0; min-width: 0; }\n.datos__ruta { overflow-wrap: anywhere; font-family: ui-monospace, monospace; font-size: 0.85rem; }\n.respaldos { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; max-height: 340px; overflow-y: auto; }\n.respaldos__item { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; border: 1px solid var(--borde); border-radius: var(--radio-s); }\n.respaldos__texto { display: grid; gap: 2px; min-width: 0; font-size: 0.9rem; }\n.respaldos__texto span { color: var(--texto-suave); font-size: 0.8rem; overflow-wrap: anywhere; }\n.qr { width: 200px; max-width: 100%; border-radius: var(--radio-s); overflow: hidden; background: #fff; }\n.qr svg { display: block; width: 100%; height: auto; }\n.direcciones { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }\n.header__ajustes { margin-left: auto; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: var(--texto-suave); }\n.header__ajustes:hover, .header__ajustes[aria-current='page'] { color: var(--acento); }\n/* Entrenar, historial, progreso y gráficos. */\r\n\r\n\r\n.boton--grande { min-height: 60px; font-size: 1.05rem; }\r\n.boton--peligro-texto { color: var(--peligro); justify-self: center; }\r\n.seccion__subtitulo { margin: 8px 0 0; font-size: 0.95rem; }\r\n.vacio { display: grid; justify-items: center; gap: 12px; text-align: center; padding: 28px 20px; color: var(--texto-suave); }\r\n.vacio svg { color: var(--acento); }\r\n.vacio p { margin: 0; max-width: 44ch; }\r\n\r\n/* ---- Estadísticas ---- */\r\n.estadisticas { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin: 0; }\r\n.estadisticas--grandes { grid-template-columns: repeat(2, 1fr); }\r\n@media (min-width: 700px) { .estadisticas--grandes { grid-template-columns: repeat(4, 1fr); } }\r\n.estadistica { display: grid; align-content: start; gap: 4px; padding: 14px; background: var(--superficie); border: 1px solid var(--borde); border-radius: var(--radio-m); }\r\n.estadistica dt { color: var(--texto-suave); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }\r\n.estadistica dd { margin: 0; font-family: var(--fuente-titulo); font-size: 1.3rem; font-weight: 700; display: flex; align-items: center; gap: 6px; }\r\n.estadistica__nota { color: var(--texto-suave); font-size: 0.8rem; }\r\n.estadistica__nota--acento { color: var(--acento); font-weight: 800; }\r\n.estadistica--racha dd svg { color: var(--acento-2); }\r\n.estadistica--destacada { border-color: color-mix(in srgb, var(--acento) 55%, var(--borde)); background: color-mix(in srgb, var(--acento) 8%, var(--superficie)); }\r\n.estadistica--destacada dd { color: var(--acento); }\r\n\r\n.resumen-sesion { display: grid; gap: 14px; }\r\n.resumen-sesion__titulo { margin: 0; color: var(--acento); }\r\n.resumen-sesion__nota { margin: 0; color: var(--texto-suave); font-style: italic; }\r\n.resumen-metricas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }\r\n@media (min-width: 700px) { .resumen-metricas { grid-template-columns: repeat(4, minmax(0, 1fr)); } }\r\n.resumen-metricas .metrica__numero { font-size: var(--t-titulo); }\r\n.resumen-grupo { display: grid; gap: 14px; }\r\n.records-nuevos { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }\r\n.record-nuevo { display: flex; gap: 10px; align-items: center; padding: 12px 14px; border-radius: var(--radio-m); background: color-mix(in srgb, var(--record) 12%, transparent); border: 1px solid color-mix(in srgb, var(--record) 45%, transparent); }\r\n.record-nuevo svg { color: var(--record); flex: none; }\r\n\r\n/* ---- Elegir qué entrenar ---- */\r\n.elegir-rutina { display: grid; gap: 12px; }\r\n.elegir-rutina__nombre { margin: 0; font-family: var(--fuente-titulo); font-stretch: 75%; font-size: var(--t-subtitulo); }\r\n.elegir-rutina__dias { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }\r\n.dia-elegir { display: flex; align-items: center; gap: 12px; min-height: 64px; padding: 10px 16px; text-align: left; background: var(--superficie-2); border: 1px solid var(--borde); border-radius: var(--radio-m); }\r\n.dia-elegir:hover:not(:disabled) { border-color: var(--acento); }\r\n.dia-elegir:active:not(:disabled) { transform: scale(0.98); }\r\n.dia-elegir:disabled { opacity: 0.5; cursor: not-allowed; }\r\n.dia-elegir svg { color: var(--acento); flex: none; }\r\n.dia-elegir__texto { display: grid; min-width: 0; }\r\n.dia-elegir__texto strong { overflow-wrap: anywhere; }\r\n.dia-elegir__texto span { color: var(--texto-suave); font-size: 0.82rem; }\r\n\r\n/* ---- Sesión en curso ---- */\r\n.entrenando { padding-bottom: 96px; }\r\n.sesion-cab { display: grid; gap: 14px; }\r\n@media (min-width: 900px) { .sesion-cab { position: sticky; top: 6px; z-index: 5; box-shadow: var(--sombra); } }\r\n.sesion-cab h1 { margin: 0; font-size: var(--t-subtitulo); font-stretch: 75%; overflow-wrap: anywhere; }\r\n.sesion-cab__sup { margin: 0 0 4px; color: var(--acento); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; font-size: var(--t-chico); }\r\n.sesion-cab__datos { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }\r\n.sesion-cab__reloj { font-size: var(--t-display); line-height: 1; }\r\n.sesion-cab__series { margin: 0; color: var(--texto-suave); font-weight: 700; font-size: var(--t-subtitulo); }\r\n\r\n.ej-sesion { display: grid; gap: 12px; padding: 14px; background: var(--superficie); border: 1px solid var(--borde); border-radius: var(--radio-l); }\r\n.ej-sesion__cab { display: flex; align-items: center; gap: 12px; }\r\n.ej-sesion__titulo { flex: 1; min-width: 0; }\r\n.ej-sesion__titulo h2 { margin: 0; font-family: var(--fuente-titulo); font-stretch: 75%; font-size: var(--t-subtitulo); font-weight: 800; line-height: 1.2; overflow-wrap: anywhere; }\r\n.ej-sesion__titulo h2 a:hover { color: var(--acento); }\r\n.ej-sesion--actual { border-color: var(--acento); }\r\n.ej-sesion__meta { margin: 2px 0 0; color: var(--texto-suave); font-size: 0.85rem; }\r\n.miniatura--grande { width: 84px; }\r\n\r\n.series